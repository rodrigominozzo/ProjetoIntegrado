{
  "name": "atende-ai",
  "version": "1.0.0",
  "description": "Plataforma genérica de atendimento e agendamento com agente de IA no WhatsApp (clínicas, consultórios, estética, pet, etc.)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "reset": "rm -f data/app.db && node --no-warnings src/seed.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.21.2"
  }
}
