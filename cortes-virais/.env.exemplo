# Copie para .env e preencha.
ANTHROPIC_API_KEY=
# Ou a IA gratuita da NVIDIA Build (ia.provedor: nvidia no config.yaml):
NVIDIA_API_KEY=
# Só para a busca aberta (fontes.exigir_autorizacao: false):
YOUTUBE_API_KEY=
# Conta profissional do Instagram (Graph API, permissão instagram_content_publish):
IG_USER_ID=
IG_ACCESS_TOKEN=
# TikTok (app no developers.tiktok.com, Content Posting API, modo caixa de entrada):
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Só se for abrir o painel a outros aparelhos (--host 0.0.0.0). Mínimo de 8 caracteres:
PAINEL_SENHA=
